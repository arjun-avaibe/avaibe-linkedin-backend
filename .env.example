# Copy to .env and fill in. Never commit .env or share its values.

# ---- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Front-end origin(s) allowed to call the API and send changes
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/avaibe_django
# Only for the one-off `python manage.py import_legacy` from the previous FastAPI database
LEGACY_DATABASE_URL=

# ---- LinkedIn app (Developer Portal -> your app -> Auth tab)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
# Encrypts stored LinkedIn tokens. Generate once with:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Microsoft sign-in (Entra ID), see docs/microsoft-signin-setup.md.
# Until all three are set the app runs in LOCAL MODE (no sign-in, everyone is admin).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Your work email(s): become Admin on first sign-in. Comma-separated.
ADMIN_EMAILS=
# true when served over HTTPS (hosting)
COOKIE_SECURE=false

# ---- Claude (Anthropic API) for AI suggestions
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
